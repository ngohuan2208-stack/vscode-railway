# VS Code Railway - Environment Variables
# Copy this file and fill in the values, or set them in Railway dashboard.

# Required: Password to access the Web IDE
WEB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Required: Secret for session encryption (generate a random 64+ char string)
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_LONG_SECRET_STRING

# Optional: Workspace directory (default: /workspace)
# WORKSPACE_DIR=/workspace

# Optional: Log level (default: info)
# LOG_LEVEL=info

# Optional: Node environment
# NODE_ENV=production

# Optional: Timezone
# TZ=UTC
