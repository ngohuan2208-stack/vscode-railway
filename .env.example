# VS Code Railway - Environment Variables

# ── Required ───────────────────────────────────────────────────────────────────
WEB_PASSWORD=CHANGE_ME

# ── Optional ───────────────────────────────────────────────────────────────────
WORKSPACE_DIR=/workspace
LOG_LEVEL=info
GITHUB_TOKEN=

# ── NPM Global (persistent on Volume) ──────────────────────────────────────────
# npm global packages install to /workspace/.npm-global
# PATH is configured in start.sh and /etc/profile.d/npm-path.sh
NPM_CONFIG_PREFIX=/workspace/.npm-global

# ── Extensions ────────────────────────────────────────────────────────────────
# Comma-separated list of extension IDs to install at startup
# Example: INSTALL_EXTENSIONS=esbenp.prettier-vscode,dbaeumer.vscode-eslint
INSTALL_EXTENSIONS=

# ── Sandbox Settings (optional) ────────────────────────────────────────────────
SANDBOX_ENABLED=true
SANDBOX_MAX_FILE_SIZE=104857600
SANDBOX_ALLOWED_PATHS=/workspace,/tmp
SANDBOX_BLOCKED_COMMANDS=mkfs,fdisk,dd
SANDBOX_NETWORK=true
