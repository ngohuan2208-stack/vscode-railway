# VS Code Railway - Sandboxed IDE Environment Variables

# ── Required ───────────────────────────────────────────────────────────────────
WEB_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32

# ── Optional ───────────────────────────────────────────────────────────────────
WORKSPACE_DIR=/workspace
LOG_LEVEL=info
GITHUB_TOKEN=

# ── Sandbox Settings ───────────────────────────────────────────────────────────
SANDBOX_ENABLED=true
SANDBOX_MAX_FILE_SIZE=104857600
SANDBOX_ALLOWED_PATHS=/workspace,/tmp
SANDBOX_BLOCKED_COMMANDS=mkfs,fdisk,dd
SANDBOX_NETWORK=true

# ── OpenRouter API (for Cline/AI extensions) ──────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Extension Installation ─────────────────────────────────────────────────────
# Comma-separated list of extension IDs to install at startup
INSTALL_EXTENSIONS=
